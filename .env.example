# inference-server Environment Configuration

# Custom path to config.json (Default: ~/.config/inference-server/config.json)
# INF_CONFIG_PATH=/custom/path/to/config.json

# Binding settings for the FastAPI gateway
# INF_HOST=0.0.0.0
# INF_PORT=8000

# Host port mapped to the active runtime container
# INF_RUNTIME_PORT=39281

# Hugging Face token (for gated/private models like Llama 3)
# You can also use HF_TOKEN or HUGGINGFACE_HUB_TOKEN
# INF_HF_TOKEN=your_huggingface_read_token_here
